---
type Lang = 'ca' | 'es' | 'en';
type RouteGroup = Record<Lang, string>;

const {
	title = 'Torre Mejanell',
	description = 'Descobreix la Torre de Mejanell, una casa rural exclusiva a la Segarra on la història, el silenci i la calma s\'uneixen. Gaudeix d\'espais amplis, confort absolut i una atmosfera pensada per desconnectar en plena natura.',
	lang = 'ca',
	slug = '',
	translations = {},
} = Astro.props as {
	title?: string;
	description?: string;
	lang?: Lang;
	slug?: string;
	translations?: Partial<RouteGroup>;
};

import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
// Base site; prefer Astro.site if configured, fallback to production hostname
const SITE = Astro.site ?? 'https://castelldemejanell.com';

// base path per language
const basePaths: RouteGroup = { ca: '/', es: '/es/', en: '/en/' };

// Known route groups for this site. Each group maps a single content page across languages.
const routeGroups: RouteGroup[] = [
	{ ca: '', es: '', en: '' },
	{ ca: 'historia', es: 'historia', en: 'history' },
	{ ca: 'habitacions', es: 'habitaciones', en: 'rooms' },
	{ ca: 'la-casa', es: 'la-casa', en: 'the-house' },
	{ ca: 'entorn', es: 'entorno', en: 'surroundings' },
	{ ca: 'localitzacio', es: 'como-llegar', en: 'location' },
	{ ca: 'fotos', es: 'fotos', en: 'photos' },
	{ ca: 'preus-i-reserves', es: 'precios-y-reservas', en: 'prices-and-booking' },
	{ ca: 'turisme', es: 'turismo', en: 'tourism' },
	{ ca: 'opinions', es: 'opiniones', en: 'reviews' },
	{ ca: 'preus-i-ocupacio', es: 'precios-y-ocupacion', en: 'prices-and-occupancy' },
	{ ca: 'la-vinya', es: 'la-viña', en: 'the-vineyard'},
	{ ca: 'els-origens', es: 'los-origenes', en: 'the-origins'},

];

const normSlug = slug ? (slug.startsWith('/') ? slug.slice(1) : slug) : '';
const routeGroup = routeGroups.find((group) => group[lang] === normSlug) ?? null;

const localizedSlugs = routeGroup
	? routeGroup
	: {
		ca: translations.ca ?? normSlug,
		es: translations.es ?? normSlug,
		en: translations.en ?? normSlug,
	};

const makeUrl = (langKey: Lang) => {
	const base = basePaths[langKey] ?? '/';
	const targetSlug = localizedSlugs[langKey] ?? '';
	if (!targetSlug) return new URL(base, SITE).toString();
	const path = `${base}${targetSlug}`.replace(/\/+/g, '/');
	return new URL(path.endsWith('/') ? path : `${path}/`, SITE).toString();
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="shortcut icon" href="/favicon.png" type="image/png" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f6efe4" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:image" content="/torre-de-mejanell.webp" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<title>{title}</title>

		<!-- canonical for current language/page -->
		<link rel="canonical" href={makeUrl(lang)} />

		<!-- hreflang alternates -->
		<link rel="alternate" href={makeUrl('ca')} hreflang="ca" />
		<link rel="alternate" href={makeUrl('es')} hreflang="es" />
		<link rel="alternate" href={makeUrl('en')} hreflang="en" />
		<link rel="alternate" href={makeUrl('ca')} hreflang="x-default" />
	</head>
	<body>
		<Header lang={lang} slug={slug} />
		<slot />
		<Footer lang={lang} slug={slug} />
		<CookieConsent />
		<button
			id="scroll-top-button"
			class="scroll-top-button"
			type="button"
			aria-label={lang === 'ca' ? 'Pujar amunt' : lang === 'es' ? 'Subir arriba' : 'Back to top'}
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" class="scroll-top-icon">
				<path d="M12 4.5l6 6.5-1.4 1.4-3.6-3.6V19h-2V8.8L7.4 12.4 6 11l6-6.5z" fill="currentColor"/>
			</svg>
		</button>
	</body>
</html>

<script>
	const scrollTopButton = document.getElementById('scroll-top-button');

	const updateScrollTopButton = () => {
		if (!scrollTopButton) return;
		const visible = window.scrollY > 300;
		scrollTopButton.classList.toggle('is-visible', visible);
		scrollTopButton.setAttribute('aria-hidden', String(!visible));
	};

	if (scrollTopButton) {
		scrollTopButton.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});
		window.addEventListener('scroll', updateScrollTopButton, { passive: true });
		updateScrollTopButton();
	}
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		background: #f6efe4;
	}

	.scroll-top-button {
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		z-index: 80;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border: 0;
		border-radius: 9999px;
		background: rgba(122, 90, 61, 0.95);
		color: #fff;
		box-shadow: 0 16px 32px rgba(31, 26, 23, 0.18);
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transform: translateY(12px);
		transition: opacity 240ms ease, transform 240ms ease, box-shadow 240ms ease;
	}

	.scroll-top-button:hover {
		box-shadow: 0 18px 36px rgba(31, 26, 23, 0.22);
	}

	.scroll-top-button.is-visible {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	.scroll-top-icon {
		width: 1.25rem;
		height: 1.25rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-top-button {
			transition: none;
		}
	}
</style>
