---
import { Image } from 'astro:assets';

import bttImg from '../../assets/pages/entorn/ruta-bici-segarra.webp';
import vinyaImg from '../../assets/pages/entorn/vinya-torre-mejanell.webp';
import cisterImg from '../../assets/pages/entorn/cervera_interior.jpg';

interface Props {
  title?: string;
  cards?: Array<{
    eyebrow: string;
    title: string;
    description: string;
    href: string;
    alt: string;
    image: 'btt' | 'vinya' | 'cister';
    className?: string;
  }>;
}

const {
  title = 'L\'entorn de Mejanell',
  cards,
} = Astro.props as Props;

const defaultCards = [
  {
    eyebrow: 'Turisme Actiu',
    title: 'Descobreix rutes úniques i paisatges espectaculars sobre dues rodes',
    description: 'Descobreix rutes úniques, senders mil·lenaris i paisatges espectaculars sobre dues rodes.',
    href: '/entorn#turisme',
    alt: 'Rutes de BTT i senderisme a la Segarra',
    image: 'btt' as const,
    className: 'entorn-card md:col-span-7 md:row-span-2 h-[550px] rounded-[2.5rem] relative overflow-hidden group block opacity-0',
  },
  {
    eyebrow: 'Gastronomia',
    title: 'Enoturisme i restaurants de la comarca',
    description: 'Tasts de vins de proximitat i cuina tradicional de la nostra terra.',
    href: '/entorn#gastronomia',
    alt: 'Vinyes i enoturisme a Torre Mejanell',
    image: 'vinya' as const,
    className: 'entorn-card md:col-span-5 md:col-start-8 md:row-start-1 h-[450px] rounded-[2.5rem] relative overflow-hidden group block opacity-0 md:mt-6',
  },
  {
    eyebrow: 'Cultura',
    title: 'Patrimoni Històric',
    description: 'Explora la Ruta del Cister i els castells de la Segarra',
    href: '/entorn#patrimoni',
    alt: 'Patrimoni històric i Ruta del Cister',
    image: 'cister' as const,
    className: 'entorn-card md:col-span-12 md:row-start-3 h-[380px] rounded-[2.5rem] relative overflow-hidden group block opacity-0 mt-8',
  },
];

const cardItems = cards ?? defaultCards;
const imageMap = {
  btt: bttImg,
  vinya: vinyaImg,
  cister: cisterImg,
};
---

<section id="entorn-preview" class="relative py-32 bg-[#e5e1dc] overflow-hidden">
  <div class="absolute inset-0 opacity-[0.08] pointer-events-none" 
       style="background-image: radial-gradient(#7a5a3d 1px, transparent 1px); background-size: 40px 40px;">
  </div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <h2 id="entorn-title" class="mx-auto text-4xl leading-[0.95] tracking-[-0.04em] text-[#1f1a17] sm:text-5xl lg:text-[4.4rem] mb-24 text-center opacity-0">
      {title}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:auto-rows-[minmax(0,auto)] items-start">
      {cardItems.map((card, index) => {
        const imageSrc = imageMap[card.image];
        const layoutClass = index === 0
          ? 'md:col-span-7 md:row-span-2 md:h-[550px]'
          : index === 1
            ? 'md:col-span-5 md:col-start-8 md:h-[550px]'
            : 'md:col-span-12 md:h-[320px] md:mt-8';

        return (
          <a href={card.href} class={`entorn-card ${layoutClass} ${card.className ?? ''} h-[340px] rounded-[2.5rem] relative overflow-hidden group block opacity-0`}>
            <div class="absolute inset-0 overflow-hidden rounded-[2.5rem]">
              <Image 
                src={imageSrc} 
                alt={card.alt} 
                class="w-full h-full object-cover transition-transform duration-[1.2s] cubic-bezier-[0.25,1,0.5,1] group-hover:scale-105"
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent transition-opacity duration-500 group-hover:opacity-90"></div>
            <div class="absolute bottom-12 left-12 right-12 text-white transform transition-transform duration-700 cubic-bezier-[0.25,1,0.5,1] group-hover:-translate-y-2">
              <span class="text-xs tracking-[0.2em] uppercase font-bold opacity-70 block mb-2">{card.eyebrow}</span>
              <h3 class="text-4xl font-serif">{card.title}</h3>
              <p class="text-white/0 text-sm mt-3 font-sans opacity-0 transition-all duration-500 delay-75 group-hover:text-white/80 group-hover:opacity-100 max-w-sm">
                {card.description}
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Base del contenedor para suavizar las sombras de alta gama */
  .entorn-card {
    transition: transform 0.7s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.7s cubic-bezier(0.25, 1, 0.5, 1);
    box-shadow: 0 10px 30px -10px rgba(31, 26, 23, 0.08);
  }
  
  /* Al hacer hover, la tarjeta se eleva ligeramente y proyecta una sombra profunda ambiental */
  .entorn-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 30px 60px -15px rgba(31, 26, 23, 0.25);
  }

  /* Curvas de aceleración personalizadas para los elementos internos */
  .cubic-bezier-\[0\.25\,1\,0\.5\,1\] {
    transition-timing-function: cubic-bezier(0.25, 1, 0.5, 1);
  }
</style>

<script>
  if (typeof window !== "undefined") {
    const motion = await import("motion");
    const { animate, inView, stagger } = motion as any;

    inView("#entorn-preview", () => {
      animate("#entorn-title", { opacity: [0, 1], y: [30, 0] }, { duration: 0.8, easing: "ease-out" });
      animate(".entorn-card", { opacity: [0, 1], y: [60, 0] }, { duration: 1, delay: stagger(0.18), easing: [0.25, 1, 0.5, 1] });
    }, { margin: "-10%" });
  }
</script>