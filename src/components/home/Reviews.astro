---
interface Props {
  heading?: string;
  eyebrow?: string;
}

const {
  heading = 'Què diuen els nostres clients',
  eyebrow = 'Testimonis',
} = Astro.props as Props;
---

<section class="px-6 mt-10 md:mt-16">
	<div class="mx-auto w-full max-w-6xl space-y-1 md:space-y-2">
		<div class="text-center">
			<p class="mb-2 text-sm font-extrabold uppercase tracking-[0.22em] text-[#7a5a3d]">{eyebrow}</p>
			<h2 id="reviews-heading" class="mx-auto max-w-[18ch] text-4xl leading-[0.95] tracking-[-0.04em] text-[#1f1a17] sm:text-5xl lg:text-[4.4rem]">
				{heading}
			</h2>
		</div>

		<div class="-mt-16 md:-mt-20">
			<div id="shapo-widget-e69c74160d1f50a79b4f"></div>
		</div>
	</div>
</section>