---
import { Image } from 'astro:assets';

interface Props {
    lang?: 'ca' | 'es' | 'en';
}

const { lang = 'ca' } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/pages/rooms/*.{jpeg,jpg,png,gif,webp}', { eager: true });

const rawRooms = [
    { title: 'Habitació 3 persones', text: 'Habitació de dos llits individuals amb bressol i lavabo.', image: '../../assets/pages/rooms/torre-mejanell-3-persones.webp' },
    { title: 'Habitació doble', text: 'Habitació a la planta baixa amb llit de matrimoni.', image: '../../assets/pages/rooms/torre-mejanell-doble2.webp' },
    { title: 'Habitació 2 persones', text: 'Llit de matrimoni', image: '../../assets/pages/rooms/torre-mejanell-2-persones3.webp' },
];

const rooms = rawRooms.filter(r => images[r.image]);
---

<section id="full-screen-slider" class="relative w-full h-[85vh] overflow-hidden">
    <!-- Slides -->
    {rooms.map((room, index) => (
        <div class:list={["absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out", index === 0 ? "opacity-100 z-10" : "opacity-0 z-0"]} data-panel={index}>
            <Image 
                src={images[room.image].default} 
                alt={room.title} 
                class="w-full h-full object-cover brightness-[0.7]"
            />
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6 text-white">
                <h2 class="text-5xl md:text-7xl font-serif mb-6">{room.title}</h2>
                <p class="text-lg md:text-xl font-light max-w-2xl">{room.text}</p>
            </div>
        </div>
    ))}

    <!-- Controles -->
    <button id="prev-btn" class="absolute left-6 top-1/2 -translate-y-1/2 z-30 p-4 rounded-full bg-white/10 hover:bg-white/20 transition-all backdrop-blur-md">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button id="next-btn" class="absolute right-6 top-1/2 -translate-y-1/2 z-30 p-4 rounded-full bg-white/10 hover:bg-white/20 transition-all backdrop-blur-md">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
</section>

<script>
    import { animate } from "motion";

    const panels = document.querySelectorAll("[data-panel]");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");
    
    let currentIndex = 0;
    let autoplayInterval: ReturnType<typeof setInterval>;

    function showSlide(index: number) {
        panels.forEach((p, i) => {
            animate(p as HTMLElement, { opacity: i === index ? 1 : 0 }, { duration: 0.8 });
            (p as HTMLElement).style.zIndex = i === index ? "10" : "0";
        });
        currentIndex = index;
    }

    function startAutoplay() {
        autoplayInterval = setInterval(() => {
            showSlide((currentIndex + 1) % panels.length);
        }, 5000); // Cambia cada 5 segundos
    }

    function resetAutoplay() {
        clearInterval(autoplayInterval);
        startAutoplay();
    }

    prevBtn?.addEventListener("click", () => {
        showSlide((currentIndex - 1 + panels.length) % panels.length);
        resetAutoplay();
    });

    nextBtn?.addEventListener("click", () => {
        showSlide((currentIndex + 1) % panels.length);
        resetAutoplay();
    });

    // Iniciar el ciclo automático al cargar
    startAutoplay();
</script>