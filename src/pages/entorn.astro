---
export const lang = 'ca';
export const slug = 'entorn';

import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import { Image } from 'astro:assets';

import cisterImg from '../assets/pages/entorn/cister.webp';
import botigues from '../assets/pages/entorn/botigues.webp';  
import bttImg from '../assets/pages/entorn/btt-segarra.webp';
import vinyaImg from '../assets/pages/entorn/vinya-torre-mejanell.webp';
import correfocImg from '../assets/pages/entorn/correfoc.webp';
import gastronomia1 from '../assets/pages/entorn/gastronomia1.webp';
import gastronomia2 from '../assets/pages/entorn/gastronomia2.webp';
---

<Layout lang={lang} slug={slug} title="Guia de l'Entorn | Castell de Mejanell">
  <Hero
    tag="Descobreix la Segarra"
    title="L'Entorn de Mejanell"
    subtitle="Hem ordenat tota la informació de dalt a baix perquè puguis llegir-la de manera clara: activitats, gastronomia, comerç i visites de proximitat."
    image={cisterImg}
  />

  <main class="bg-[#fcfbfa] text-[#1f1a17] py-20 md:py-32 relative z-10">
    <div class="max-w-7xl mx-auto px-8 md:px-12 space-y-28 md:space-y-36">
      <section id="turisme-actiu" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7 space-y-8">
          <div class="space-y-4">
            <p class="text-xs tracking-[0.3em] uppercase font-bold text-[#7a5a3d]">Turisme actiu</p>
            <h2 class="text-4xl md:text-5xl font-serif text-[#7a5a3d]">Natura i esport</h2>
            <p class="text-base md:text-lg text-[#6b5f56] leading-relaxed max-w-2xl">
              Viu el territori d'una manera diferent amb activitats a l'aire lliure, opcions d'aventura i instal·lacions esportives properes per a totes les edats.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <article class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-white p-8 shadow-sm space-y-5">
              <h3 class="text-lg font-serif text-[#1f1a17]">Aventura i aigua</h3>
              <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
                <li>Rutes de senderisme</li>
                <li>Rutes de BTT</li>
                <li>Vols amb globus</li>
                <li>Passeigs a cavall</li>
                <li>Cervera Aventura amb paintball i altres activitats</li>
                <li>Caiac al Club Nàutic Segre-Rialb i La Pica Trips al riu Segre</li>
              </ul>
            </article>

            <article class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-[#f4f1ed] p-8 shadow-sm space-y-5">
              <h3 class="text-lg font-serif text-[#1f1a17]">Instal·lacions properes</h3>
              <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
                <li>Golf / Pitch &amp; Putt a l'Àrea de Guissona</li>
                <li>Esquí al Port del Comte, a 1 hora</li>
                <li>Piscines cobertes a Cervera</li>
                <li>Piscines públiques a Sant Ramon</li>
                <li>Pistes de pàdel a BonÀrea i Sant Ramon</li>
              </ul>
            </article>
          </div>

          <div class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-[#fffaf5] p-8 shadow-sm">
            <p class="text-xs tracking-wider uppercase font-bold text-[#7a5a3d]">Bicicletes disponibles a la casa</p>
            <p class="mt-3 text-sm text-[#6b5f56] leading-relaxed">
              Teniu a disposició 4 bicicletes de muntanya per a adults i 3 bicicletes infantils, en talla petita i mitjana.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="grid grid-cols-2 gap-4">
            <figure class="rounded-[2rem] overflow-hidden bg-[#e5e1dc] shadow-sm aspect-[4/5]">
              <Image src={bttImg} alt="Rutes de BTT per la Segarra" class="w-full h-full object-cover" />
            </figure>
            <figure class="rounded-[2rem] overflow-hidden bg-[#e5e1dc] shadow-sm aspect-[4/5] mt-10">
              <Image src={vinyaImg} alt="Passeig per vinyes a l'entorn de Mejanell" class="w-full h-full object-cover" />
            </figure>
          </div>
        </div>
      </section>

      <section id="gastronomia" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7 space-y-8">
          <div class="space-y-4">
            <p class="text-xs tracking-[0.3em] uppercase font-bold text-[#7a5a3d]">Gastronomia</p>
            <h2 class="text-4xl md:text-5xl font-serif text-[#7a5a3d]">Bars i restaurants recomanats</h2>
            <p class="text-base md:text-lg text-[#6b5f56] leading-relaxed max-w-2xl">
              La cuina de la Segarra destaca pels productes de proximitat, els restaurants de poble i una oferta de vins i caves molt vinculada al territori.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <article class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-white p-8 shadow-sm space-y-5">
              <h3 class="text-lg font-serif text-[#1f1a17]">Sant Ramon</h3>
              <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
                <li>Bar Les Planes</li>
                <li>Bar Centre, davant del Monestir</li>
              </ul>
              <h3 class="text-lg font-serif text-[#1f1a17] pt-2">Cervera</h3>
              <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
                <li>El Gran Cafè</li>
                <li>Els Comdals</li>
                <li>Rostisseria Romina, per emportar</li>
              </ul>
            </article>

            <article class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-[#f4f1ed] p-8 shadow-sm space-y-5">
              <h3 class="text-lg font-serif text-[#1f1a17]">Torà i altres opcions</h3>
              <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
                <li>Can Jaumet</li>
                <li>El Gòtic</li>
                <li>Torrecombelles</li>
                <li>Àrea de Guissona, amb buffet lliure</li>
                <li>La Bassa a Guissona</li>
              </ul>
            </article>
          </div>

          <div class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-[#fffaf5] p-8 shadow-sm space-y-4">
            <p class="text-xs tracking-wider uppercase font-bold text-[#7a5a3d]">Enoturisme</p>
            <p class="text-sm text-[#6b5f56] leading-relaxed">
              A 25-30 minuts de la casa tens cellers del Bages, la botiga especialitzada <span class="font-medium text-[#7a5a3d]">ARTIUM</span> a Artés, visites a Sant Sadurní d'Anoia amb Codorníu i el Castell del Remei, amb vins de gran qualitat.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="grid grid-cols-2 gap-4">
            <figure class="rounded-[2rem] overflow-hidden bg-[#e5e1dc] shadow-sm aspect-[4/5]">
              <Image src={gastronomia1} alt="Gastronomia local" class="w-full h-full object-cover" />
            </figure>
            <figure class="rounded-[2rem] overflow-hidden bg-[#e5e1dc] shadow-sm aspect-[4/5] mt-10">
              <Image src={gastronomia2} alt="Gastronomia local" class="w-full h-full object-cover" />
            </figure>
          </div>
        </div>
      </section>

      <section id="festes-cultural" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7 space-y-8">
          <div class="space-y-4">
            <p class="text-xs tracking-[0.3em] uppercase font-bold text-[#7a5a3d]">Festes i actes culturals</p>
            <h2 class="text-4xl md:text-5xl font-serif text-[#7a5a3d]">Festes, cultura i tradicions</h2>
            <p class="text-base md:text-lg text-[#6b5f56] leading-relaxed max-w-2xl">
              Una agenda molt viva amb celebracions populars, teatre, Setmana Santa, tradicions nadalenques i fires gastronòmiques durant tot l'any.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <article class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-white p-8 shadow-sm space-y-5">
              <h3 class="text-lg font-serif text-[#1f1a17]">Festes populars</h3>
              <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
                <li>Akelarre de Cervera, a l'agost</li>
                <li>Festa Major de Sant Ramon amb els Tres Tombs, el 31 d'agost</li>
                <li>Fira de l'Ou de Sant Guim de Freixenet, al juny</li>
              </ul>
            </article>

            <article class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-[#f4f1ed] p-8 shadow-sm space-y-5">
              <h3 class="text-lg font-serif text-[#1f1a17]">Cultura i espectacles</h3>
              <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
                <li>Fira del Teatre de Tàrrega, al setembre</li>
                <li>La Passió de Cervera, durant Setmana Santa</li>
                <li>Fira del Torró i la Xocolata d'Agramunt</li>
              </ul>
            </article>
          </div>

          <div class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-[#fffaf5] p-8 shadow-sm space-y-4">
            <p class="text-xs tracking-wider uppercase font-bold text-[#7a5a3d]">Tradicions nadalenques</p>
            <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
              <li>Pessebre Vivent de Sant Guim de la Plana</li>
              <li>Pessebres vivents de Torres de Fals i altres poblacions</li>
              <li>Pastorets de Calaf</li>
            </ul>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-[2rem] overflow-hidden bg-[#e5e1dc] shadow-sm aspect-[4/5]">
            <Image src={correfocImg} alt="Festes i tradicions de la Segarra" class="w-full h-full object-cover" />
          </div>
        </div>
      </section>

      <section id="comerc-proximitat" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7 space-y-8">
          <div class="space-y-4">
            <p class="text-xs tracking-[0.3em] uppercase font-bold text-[#7a5a3d]">Comerç de proximitat</p>
            <h2 class="text-4xl md:text-5xl font-serif text-[#7a5a3d]">Productes locals i mercats</h2>
            <p class="text-base md:text-lg text-[#6b5f56] leading-relaxed max-w-2xl">
               Comerç de proximitat i productes artesans
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <article class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-white p-8 shadow-sm space-y-5">
              <h3 class="text-lg font-serif text-[#1f1a17]">Forns de pa</h3>
              <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
                <li>Chocolate Box - Cal Colom, a Cervera</li>
                <li>Pa d'Abans, a Cervera</li>
                <li>La Garbiana, a Tarroja</li>
                <li>Forn de pa de Sant Ramon</li>
              </ul>
            </article>

            <article class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-[#f4f1ed] p-8 shadow-sm space-y-5">
              <h3 class="text-lg font-serif text-[#1f1a17]">Carnisseries</h3>
              <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
                <li>Can Magí, a Torà</li>
                <li>Can Vilà, a Cervera</li>
                <li>Àrea de Guissona</li>
              </ul>
            </article>
          </div>

          <div class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-[#fffaf5] p-8 shadow-sm">
            <p class="text-xs tracking-wider uppercase font-bold text-[#7a5a3d]">Mercats setmanals</p>
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center text-sm">
              <div class="rounded-xl border border-[#d8d3cb]/30 bg-white p-4 shadow-sm">
                <strong>Dilluns</strong>
                <br />
                <span class="text-[#7a5a3d] font-medium">Tàrrega</span>
              </div>
              <div class="rounded-xl border border-[#d8d3cb]/30 bg-white p-4 shadow-sm">
                <strong>Divendres</strong>
                <br />
                <span class="text-[#7a5a3d] font-medium">Cervera</span>
              </div>
              <div class="rounded-xl border border-[#d8d3cb]/30 bg-white p-4 shadow-sm">
                <strong>Dissabte</strong>
                <br />
                <span class="text-[#7a5a3d] font-medium">Calaf</span>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-4">
          <div class="rounded-[2rem] overflow-hidden bg-[#e5e1dc] shadow-sm aspect-[4/5]">
            <Image src={botigues} alt="Mercats i patrimoni proper" class="w-full h-full object-cover" />
          </div>
        </div>
      </section>

      <section id="visites-proximitat" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-7 space-y-8">
          <div class="space-y-4">
            <p class="text-xs tracking-[0.3em] uppercase font-bold text-[#7a5a3d]">Visites de proximitat</p>
            <h2 class="text-4xl md:text-5xl font-serif text-[#7a5a3d]">Patrimoni històric i cultural</h2>
            <p class="text-base md:text-lg text-[#6b5f56] leading-relaxed max-w-2xl">
              Descobreix castells i pobles medievals que fan de la Segarra un territori amb una història i una identitat úniques
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <article class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-white p-8 shadow-sm space-y-5">
              <h3 class="text-lg font-serif text-[#1f1a17]">Patrimoni històric</h3>
              <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
                <li>Monestir de Sant Ramon</li>
                <li>Montfalcó Murallat</li>
                <li>Casc antic de Cervera</li>
                <li>Carreró de les Bruixes</li>
                <li>Ruta dels Castells de la Segarra</li>
                <li>Centre d'Interpretació dels Castells del Sió a Concabella</li>
              </ul>
            </article>

            <article class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-[#f4f1ed] p-8 shadow-sm space-y-5">
              <h3 class="text-lg font-serif text-[#1f1a17]">Més per visitar</h3>
              <ul class="space-y-2 text-sm text-[#6b5f56] leading-relaxed list-disc pl-5">
                <li>Torre de Vallferosa</li>
                <li>Ciutat Romana de Guissona</li>
                <li>Memorial de la Guerra Civil de Pujalt</li>
                <li>Mines de sal de Cardona</li>
                <li>Museu del Monestir de Sant Ramon</li>
                <li>Museu de la Pagesia, Museu Comarcal i Museu Marc Márquez</li>
              </ul>
            </article>
          </div>

          <div class="rounded-[1.75rem] border border-[#d8d3cb]/50 bg-[#fffaf5] p-8 shadow-sm space-y-4">
            <p class="text-xs tracking-wider uppercase font-bold text-[#7a5a3d]">Pobles i rutes culturals</p>
            <p class="text-sm text-[#6b5f56] leading-relaxed">
              També val la pena fer una parada a Verdú, Pujalt, Guimerà, Penelles, Món Sant Benet i el Monestir de Montserrat, a més dels castells de les Pallargues, Florejacs i Cardona.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5">
          <figure class="rounded-[2rem] overflow-hidden bg-[#e5e1dc] shadow-sm">
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/2/27/Monestir_de_Santa_Maria_de_Vallbona_%28Vallbona_de_les_Monges%29_-_2.jpg"
              alt="Monestir de Santa Maria de Vallbona (Vallbona de les Monges)"
              class="w-full aspect-[4/5] object-cover"
            />
          </figure>
          <figcaption class="text-xs text-[#6b5f56] mt-2 px-1">
            Foto: Maria Rosa Ferré,
            <a href="https://creativecommons.org/licenses/by-sa/2.0" target="_blank" rel="license noopener">CC BY-SA 2.0</a>,
            via <a href="https://commons.wikimedia.org/wiki/File:Monestir_de_Santa_Maria_de_Vallbona_(Vallbona_de_les_Monges)_-_2.jpg" target="_blank" rel="noopener">Wikimedia Commons</a>
          </figcaption>
        </div>
      </section>
    </div>
  </main>
</Layout>