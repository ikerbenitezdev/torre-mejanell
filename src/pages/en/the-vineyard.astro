---
export const lang = 'en';
export const slug = 'the-vineyard';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Hero from '../../components/home/Hero.astro';

import vinya from '../../assets/pages/entorn/vinya-torre-mejanell.webp';
import vinyaCamp from '../../assets/pages/historia/vinya/camp-vinya.webp';
import vinyaTall from '../../assets/pages/historia/vinya/tall-vinya.webp';
import viEtiqueta from '../../assets/pages/historia/vinya/vi-etiqueta.webp';
import vinyaElaboracio from '../../assets/pages/historia/vinya/vinya-mejanell-elaboracio.webp';
import vinyaRecollida from '../../assets/pages/historia/vinya/vinya-mejanell-recollida.webp';
import vinyaVi from '../../assets/pages/historia/vinya/vinya-mejanell-vi.webp';
---

<Layout lang={lang} slug={slug} title="The vineyard | Torre de Mejanell">
  <main class="bg-[#fcfbf9] text-[#1f1a17] overflow-x-hidden">
    <Hero tag="History" title="The Vineyard" subtitle="Discover the process of cultivating and making our wine." image={vinya} />

    <section class="py-24 px-6 max-w-6xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-6">
          <h2 class="text-4xl font-serif text-[#1f1a17]">Recovering the legacy of the vineyard</h2>
          <div class="space-y-4 text-base text-[#6b5f56] leading-relaxed">
            <p>In the past, Torre de Mejanell was an agricultural estate with various crops, including vineyards.</p>
            <p>Today, we have chosen to recover a small part of this legacy by cultivating a small vineyard and producing our own wine, just as was done traditionally.</p>
          </div>
        </div>

        <div class="aspect-[4/3] bg-[#e8e4de] rounded-2xl flex items-center justify-center text-[#7a5a3d]/50 italic overflow-hidden shadow-lg">
          <Image src={vinyaTall} alt="Work in the vineyard of Torre de Mejanell" class="w-full h-full object-cover rounded-2xl" />
        </div>
      </div>

      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-6 items-stretch">
        <div class="lg:col-span-4 aspect-[16/10] bg-[#e8e4de] rounded-2xl overflow-hidden shadow-lg">
          <Image src={vinyaCamp} alt="Vineyard field" class="w-full h-full object-cover rounded-2xl" />
        </div>
        <div class="lg:col-span-2 rounded-2xl overflow-hidden shadow-lg flex items-center justify-center">
          <Image src={viEtiqueta} alt="Wine label from Torre de Mejanell" class="w-full h-auto object-contain" />
        </div>
        <div class="lg:col-span-2 aspect-[4/3] bg-[#e8e4de] rounded-2xl overflow-hidden shadow-lg">
          <Image src={vinyaRecollida} alt="Grape harvest" class="w-full h-full object-cover rounded-2xl" />
        </div>
        <div class="lg:col-span-2 aspect-[4/3] bg-[#e8e4de] rounded-2xl overflow-hidden shadow-lg">
          <Image src={vinyaElaboracio} alt="Wine making" class="w-full h-full object-cover rounded-2xl" />
        </div>
        <div class="lg:col-span-2 aspect-[4/3] bg-[#e8e4de] rounded-2xl overflow-hidden shadow-lg">
          <Image src={vinyaVi} alt="Wine-making space" class="w-full h-full object-cover rounded-2xl" />
        </div>
      </div>
    </section>
  </main>
</Layout>
