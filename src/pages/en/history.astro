---
export const lang = 'en';
export const slug = 'history';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import BuildingAnimation from '../../components/home/BuildTower.astro';

import castellAntic from '../../assets/pages/historia/torre-mejanell-antiga.webp';
import historiaTorre from '../../assets/pages/historia/historia-torre.webp';
import antigaTorre from '../../assets/pages/historia/historica-torre.webp';
---

<Layout lang={lang} slug={slug} title="Our history and wine | Torre de Mejanell">
  <main class="bg-[#fcfbf9] text-[#1f1a17] overflow-x-hidden">
    <section class="relative min-h-[90vh] flex flex-col lg:flex-row items-center justify-center bg-[#1a1715] px-10 py-20 md:py-0 md:px-20 gap-12 overflow-hidden border-b border-[#2d2a28]">
      <div class="absolute inset-0 bg-gradient-to-br from-[#26211e] via-[#1a1715] to-[#12100f] pointer-events-none"></div>
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('https://www.transparenttextures.com/patterns/carbon-fibre.png');"></div>

      <div class="w-full lg:w-1/2 max-w-xl relative z-10 space-y-8 text-left lg:pr-12">
        <span class="inline-block text-[10px] font-bold tracking-[0.3em] uppercase text-[#c5a073]">Legacy, stone and transformation</span>
        <h1 id="hero-title" class="text-5xl md:text-7xl font-serif text-[#f4efe9] tracking-tight leading-[0.95]">
          How our story was built <br><span class="italic text-[#c5a073]">from the ground up</span>
        </h1>
        <p id="hero-desc" class="text-base text-[#d1ccc6] font-light leading-relaxed max-w-md border-l border-[#c5a073]/30 pl-6">
          From the watchtower foundations of the 11th century to its evolution as a grand country house. An architectural journey shaped by hand, stone by stone.
        </p>
      </div>

      <div id="hero-animation" class="w-full lg:w-1/2 flex justify-center items-center relative z-10">
        <BuildingAnimation class="w-full h-auto max-w-[550px] lg:max-w-[650px] brightness-[1.1] contrast-[1.2]" />
      </div>
    </section>

    <section class="py-24 px-6 max-w-6xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-6">
          <h2 class="text-4xl font-serif text-[#1f1a17]">Restoration of the medieval complex of Torre de Mejanell</h2>
          <div class="space-y-4 text-base text-[#6b5f56] leading-relaxed">
            <p>From the watchtower of the 11th century to the present day.</p>
          </div>
        </div>
        <div class="aspect-[4/3] bg-[#e8e4de] rounded-2xl flex items-center justify-center text-[#7a5a3d]/50 italic">
          <Image src={antigaTorre} alt="Castle of Mejanell" class="w-full h-full object-cover rounded-2xl" />
        </div>
      </div>

      <div class="mt-16 aspect-[21/9] bg-[#e8e4de] rounded-2xl flex items-center justify-center text-[#7a5a3d]/50 italic">
        <Image src={historiaTorre} alt="History of Torre de Mejanell" class="w-full h-full object-cover rounded-2xl" />
      </div>
    </section>

    <div class="pt-4 px-6 pb-16">
      <a href="/en/prices-and-occupancy" class="inline-flex items-center justify-center relative z-30 rounded-full text-xs px-8 py-4 font-bold bg-[#1f1a17] hover:bg-[#7a5a3d] transition-all duration-300 shadow-md hover:-translate-y-0.5 uppercase tracking-wider" style="color: #f4efe9; isolation: isolate;">
        Book your stay
      </a>
    </div>
  </main>
</Layout>

<script type="module">
  import { animate, cubicBezier } from "motion";
  const premiumEase = cubicBezier(0.16, 1, 0.3, 1);

  if (typeof window !== "undefined") {
    animate("#hero-title, #hero-desc", { opacity: [0, 1], x: [-20, 0] }, { duration: 1.4, delay: 0.3, easing: premiumEase });
    animate("#hero-animation", { opacity: [0, 1], scale: [0.95, 1] }, { duration: 1.8, easing: premiumEase });
  }
</script>
