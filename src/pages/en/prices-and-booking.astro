---
export const lang = 'en';
export const slug = 'prices-and-booking';
import Layout from '../../layouts/Layout.astro';
---

<Layout lang={lang} slug={slug} title="Prices and booking | Torre de Mejanell">
  <main class="bg-[#fcfbf9] text-[#1f1a17] overflow-x-hidden">
    <section class="max-w-7xl mx-auto px-6 py-20 lg:py-28 space-y-10">
      <div class="space-y-4 max-w-3xl">
        <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-[#7a5a3d]">Prices and booking</p>
        <h1 class="text-4xl md:text-5xl font-serif text-[#1f1a17]">Book your stay</h1>
        <p class="text-lg text-[#6b5f56] leading-relaxed">
          To check availability and rates, please contact us with your dates and the number of guests. We will respond with the best option for your trip.
        </p>
      </div>

      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10">
        <div class="rounded-[2rem] border border-[#e5dcd0] bg-white p-8 shadow-sm space-y-4">
          <h2 class="text-2xl font-serif text-[#1f1a17]">Options</h2>
          <ul class="space-y-3 text-sm leading-relaxed text-[#6b5f56] list-disc pl-5">
            <li>Weekend or full-week stays.</li>
            <li>Availability adapted to groups and family getaways.</li>
            <li>Advice on the best time of year to visit us.</li>
          </ul>
        </div>

        <div class="rounded-[2rem] border border-[#e5dcd0] bg-[#f6efe4] p-8 shadow-sm space-y-4">
          <h2 class="text-2xl font-serif text-[#1f1a17]">Contact</h2>
          <p class="text-sm leading-relaxed text-[#6b5f56]">Write to us through the form or by email and we will help you prepare your visit.</p>
          <a href="/en/contact" class="inline-flex items-center rounded-full bg-[#1f1a17] px-6 py-3 text-sm font-semibold text-[#f8f4ec] transition hover:bg-[#7a5a3d]">
            Go to contact
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
