---
export const lang = 'en';
export const slug = 'rooms';
import Layout from '../../layouts/Layout.astro';
import StaysSelector from '../../components/home/StaysSelector.astro';
import { BedDouble, Trees, ChefHat } from 'lucide-astro';
import { Image } from 'astro:assets';

import roomTriple from '../../assets/pages/rooms/torre-mejanell-3-persones.webp';
import roomDoubleGround from '../../assets/pages/rooms/torre-mejanell-doble2.webp';
import roomTwoGroundA from '../../assets/pages/rooms/torre-mejanell-2-persones3.webp';
import roomTwoFirst from '../../assets/pages/rooms/torre-mejanell-2-persones.webp';
import roomTwoGroundB from '../../assets/pages/rooms/torre-mejanell-2-persones4.webp';
import roomDoubleFirst from '../../assets/pages/rooms/torre-mejanell-doble1.webp';
import roomIndividual from '../../assets/pages/rooms/habitacio-individual1.webp';
import roomGroundFloor from '../../assets/pages/rooms/habitació planta baixa.webp';

const rooms = [
  { title: 'Triple room + cot (First floor)', text: 'A room with three single beds, a cot and a bathroom inside the bedroom.', image: roomTriple },
  { title: 'Double room (Ground floor)', text: 'A room on the ground floor for two people with a shared bathroom.', image: roomDoubleFirst },
  { title: 'Double room (Ground floor)', text: 'A room on the ground floor with two beds and a shared bathroom.', image: roomDoubleGround },
  { title: 'Twin room (First floor)', text: 'Two single beds with a shared bathroom.', image: roomTwoFirst },
  { title: 'Double room (First floor)', text: 'A double bed with a shared bathroom.', image: roomTwoGroundA },
  { title: 'Double room (Second floor)', text: 'Two single beds with a bathroom inside the bedroom.', image: roomTwoGroundB },
  { title: 'Single room (Second floor)', text: 'A room with one standard bed and the option to add a supplementary bed.', image: roomIndividual },
];
---

<Layout lang={lang} slug={slug} title="Rooms | Torre de Mejanell">
  <main class="text-[#1f1a17] overflow-x-hidden relative">
    <StaysSelector lang={lang} />

    <section class="py-20 bg-[#fcfbf9]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="mb-16 text-center">
          <h2 class="text-3xl font-serif text-[#1f1a17]">More than just a stay</h2>
          <div class="w-12 h-[1px] bg-[#7a5a3d]/40 mx-auto mt-6"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-12">
          <div class="flex flex-col items-center text-center group">
            <div class="p-4 rounded-full bg-[#f6efe4] text-[#7a5a3d] mb-6 group-hover:scale-110 transition-transform">
              <BedDouble size={32} />
            </div>
            <h3 class="font-serif text-xl mb-3">Dream comfort</h3>
            <p class="text-sm text-[#6b5f56] leading-relaxed">Enjoy restorative sleep in well-equipped beds in the calm of the Segarra.</p>
          </div>

          <div class="flex flex-col items-center text-center group">
            <div class="p-4 rounded-full bg-[#f6efe4] text-[#7a5a3d] mb-6 group-hover:scale-110 transition-transform">
              <Trees size={32} />
            </div>
            <h3 class="font-serif text-xl mb-3">A privileged setting</h3>
            <p class="text-sm text-[#6b5f56] leading-relaxed">Wake up surrounded by nature, vineyards and fields with unique views, perfect for disconnecting.</p>
          </div>

          <div class="flex flex-col items-center text-center group">
            <div class="p-4 rounded-full bg-[#f6efe4] text-[#7a5a3d] mb-6 group-hover:scale-110 transition-transform">
              <ChefHat size={32} />
            </div>
            <h3 class="font-serif text-xl mb-3">Local gastronomy</h3>
            <p class="text-sm text-[#6b5f56] leading-relaxed">Try farm products and artisan breakfasts with authentic local flavours.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-[#f4efe9]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="mb-14 rounded-[2rem] border border-[#e5dcd0] bg-white p-6 shadow-sm lg:p-8">
          <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
            <div class="space-y-4">
              <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-[#7a5a3d]">Accommodation map</p>
              <h3 class="text-2xl font-serif text-[#1f1a17]">Room layout</h3>
              <p class="text-base text-[#6b5f56] leading-relaxed">The rooms at Torre de Mejanell are arranged across the ground floor, first floor and second floor, with spaces designed for couples, families and groups.</p>
              <ul class="space-y-2 text-sm text-[#6b5f56]">
                <li>• Ground floor: more accessible rooms with easy entry.</li>
                <li>• First floor: double and family rooms with shared bathrooms.</li>
                <li>• Second floor: quieter rooms with private bathrooms in some units.</li>
              </ul>
            </div>
            <div class="overflow-hidden rounded-[1.5rem] bg-[#e8e4de] shadow-sm aspect-[4/3]">
              <Image src={roomGroundFloor} alt="Room map of Torre de Mejanell" class="h-full w-full object-cover" loading="eager" />
            </div>
          </div>
        </div>
        {rooms.map((room, index) => (
          <div class="room-card mb-12 grid md:grid-cols-[0.95fr_1.05fr] gap-8 items-center" style={`transition-delay: ${index * 140}ms`}>
            <div class="overflow-hidden rounded-2xl shadow-lg bg-[#e8e4de] aspect-[16/9]">
              <Image src={room.image} alt={room.title} class="w-full h-full object-cover object-bottom transition duration-700 ease-out hover:scale-105" />
            </div>
            <div class="space-y-4">
              <h3 class="text-2xl font-serif text-[#1f1a17]">{room.title}</h3>
              <p class="text-base text-[#6b5f56]">{room.text}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="my-12 max-w-3xl mx-auto px-5">
      <p class="text-base text-[#6b5f56] flex items-start text-left gap-2">
        <span class="h-1 w-1 rotate-45 transform shrink-0 bg-[#7a5a3d] mt-2.5"></span>
        <span>For larger groups, we offer the possibility of accommodating up to 18 people thanks to the sofa beds available in selected rooms.</span>
      </p>
    </div>
  </main>
</Layout>

<script>
  const roomCards = document.querySelectorAll('.room-card');

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    roomCards.forEach((card) => observer.observe(card));
  } else {
    roomCards.forEach((card) => card.classList.add('is-visible'));
  }
</script>
