---
export const lang = 'ca';
export const slug = 'la-vinya';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import vinya from '../../src/assets/pages/entorn/vinya-torre-mejanell.webp';
import vinyaCamp from '../../src/assets/pages/historia/vinya/camp-vinya.webp';
import vinyaTall from '../../src/assets/pages/historia/vinya/tall-vinya.webp';
import viEtiqueta from '../../src/assets/pages/historia/vinya/vi-etiqueta.webp';
import vinyaElaboracio from '../../src/assets/pages/historia/vinya/vinya-mejanell-elaboracio.webp';
import vinyaRecollida from '../../src/assets/pages/historia/vinya/vinya-mejanell-recollida.webp';
import vinyaVi from '../../src/assets/pages/historia/vinya/vinya-mejanell-vi.webp';
import Hero from '../components/home/Hero.astro';
---

<Layout lang={lang} slug={slug} title="La vinya | Torre de Mejanell">
  <main class="bg-[#fcfbf9] text-[#1f1a17] overflow-x-hidden">

    <Hero 
        tag="Història"
        title="La Vinya"
        subtitle="Coneix el procés de cultiu i elaboració del nostre vi."
        image={vinya}
    />

    <section class="py-24 px-6 max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div class="space-y-6">
                <h2 class="text-4xl font-serif text-[#1f1a17]">Recuperant el llegat de la vinya</h2>
                <div class="space-y-4 text-base text-[#6b5f56] leading-relaxed">
                    <p>Antigament, la Torre de Mejanell era una propietat agrícola amb diversitat de conreus, entre els quals hi havia la vinya.</p>
                    <p>Actualment, hem volgut recuperar una petita part d'aquest llegat amb el cultiu d'una petita vinya i l'elaboració del nostre propi vi, tal com s'havia fet tradicionalment.</p>
                </div>
            </div>

            <div class="aspect-[4/3] bg-[#e8e4de] rounded-2xl flex items-center justify-center text-[#7a5a3d]/50 italic overflow-hidden shadow-lg">
               <Image src={vinyaTall} alt="Treballs a la vinya de la Torre de Mejanell" class="w-full h-full object-cover rounded-2xl" />
            </div>
        </div>

        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-6 items-stretch">
            <div class="lg:col-span-4 aspect-[16/10] bg-[#e8e4de] rounded-2xl overflow-hidden shadow-lg">
                <Image src={vinyaCamp} alt="Camp de vinya" class="w-full h-full object-cover rounded-2xl" />
            </div>
            <div class="lg:col-span-2 rounded-2xl overflow-hidden shadow-lg flex items-center justify-center">
                <Image src={viEtiqueta} alt="Etiqueta del vi de la Torre de Mejanell" class="w-full h-auto object-contain" />
            </div>
            <div class="lg:col-span-2 aspect-[4/3] bg-[#e8e4de] rounded-2xl overflow-hidden shadow-lg">
                <Image src={vinyaRecollida} alt="Recollida del raim" class="w-full h-full object-cover rounded-2xl" />
            </div>
            <div class="lg:col-span-2 aspect-[4/3] bg-[#e8e4de] rounded-2xl overflow-hidden shadow-lg">
                <Image src={vinyaElaboracio} alt="Elaboracio del vi" class="w-full h-full object-cover rounded-2xl" />
            </div>
            <div class="lg:col-span-2 aspect-[4/3] bg-[#e8e4de] rounded-2xl overflow-hidden shadow-lg">
                <Image src={vinyaVi} alt="Espai de vinificacio" class="w-full h-full object-cover rounded-2xl" />
            </div>
        </div>
    </section>
  </main>
</Layout>

<script type="module">
    import { animate, cubicBezier } from "motion";
    const premiumEase = cubicBezier(0.16, 1, 0.3, 1);

    if (typeof window !== "undefined") {
        animate("#hero-animation", { opacity: [0, 1], scale: [0.96, 1] }, { duration: 1.8, easing: premiumEase });
    }
</script>
