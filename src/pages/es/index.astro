---
export const lang = 'es';
export const slug = '';
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/home/HeroSection.astro';
import StaysGrid from '../../components/home/StaysGrid.astro';
import KidsFunSpaces from '../../components/home/KidsFunSpaces.astro';
import ExperiencesSection from '../../components/home/ExperiencesSection.astro';
import ServicesGrid from '../../components/home/ServicesGrid.astro';
import SurroundingsBeta from '../../components/home/SurroundingsBeta.astro';
import Reviews from '../../components/home/Reviews.astro';
---

<Layout lang={lang} slug={slug} title="Torre de Mejanell | Escapada rural" description="Descubre nuestra casa rural: una antigua masía transformada en un refugio de turismo rural donde los sueños se mezclan con el encanto de la naturaleza.">
	<main>
		<HeroSection
			title="Bienvenidos a la Torre de Mejanell"
			subtitle="Castillo de Mejanell"
			description="Escápate a un paraíso rural lleno de historia"
			primaryLabel="Habitaciones"
			primaryHref="#estancias"
			secondaryLabel="Precios y ocupación"
			secondaryHref="/es/precios-y-ocupacion"
		/>
		<ExperiencesSection title="Una antigua masía restaurada y convertida en un alojamiento de turismo rural" />
		<StaysGrid
			title="Habitaciones"
			subtitle="Autenticidad · Tranquilidad · Confort"
			buttonLabel="Ver más habitaciones"
			buttonHref="/es/habitaciones"
		/>
		<KidsFunSpaces lang="es" />
		<SurroundingsBeta
			title="El entorno de Mejanell"
			cards={[
				{ eyebrow: 'Turismo Activo', title: 'Descubre rutas únicas y paisajes espectaculares sobre dos ruedas', description: 'Descubre rutas únicas, senderos milenarios y paisajes espectaculares sobre dos ruedas.', href: '/es/entorno#turismo', alt: 'Rutas de BTT y senderismo en la Segarra', image: 'btt' },
				{ eyebrow: 'Gastronomía', title: 'Enoturismo y restaurantes de la comarca', description: 'Catas de vinos de proximidad y cocina tradicional de nuestra tierra.', href: '/es/entorno#gastronomia', alt: 'Viñas y enoturismo en Torre Mejanell', image: 'vinya' },
				{ eyebrow: 'Cultura', title: 'Patrimonio Histórico', description: 'Explora la Ruta del Císter y los castillos de la Segarra', href: '/es/entorno#patrimonio', alt: 'Patrimonio histórico y Ruta del Císter', image: 'cister' },
			]}
		/>
		<ServicesGrid
			eyebrow="Comodidad y bienestar"
			heading="Servicios y equipamiento"
			houseServicesHeading="Servicios de la casa"
			kitchenHeading="Cocina equipada"
			houseItems={[
				{ icon: 'BedDouble', text: 'Camas supletorias' },
				{ icon: 'Baby', text: 'Cuna' },
				{ icon: 'ChefHat', text: 'Comida a domicilio' },
				{ icon: 'Waves', text: 'Piscina' },
				{ icon: 'Tv', text: 'TV' },
				{ icon: 'Flame', text: 'Lumbre' },
				{ icon: 'Trees', text: 'Muebles de jardín' },
				{ icon: 'Sofa', text: 'Mesa y sillas' },
				{ icon: 'Bike', text: 'Bicicletas' },
				{ icon: 'Dices', text: 'Juegos de mesa' },
				{ icon: 'Flame', text: 'Barbacoa/Carbón' },
				{ icon: 'Flame', text: 'Paella' },
			]}
			kitchenItems={[
				{ icon: 'WashingMachine', text: 'Lavadora' },
				{ icon: 'Utensils', text: 'Lavavajillas' },
				{ icon: 'Refrigerator', text: '2 Frigoríficos' },
				{ icon: 'CookingPot', text: 'Horno' },
				{ icon: 'Microwave', text: 'Microondas' },
				{ icon: 'Flame', text: 'Vitrocerámica' },
				{ icon: 'Citrus', text: 'Exprimidor' },
				{ icon: 'Utensils', text: 'Batidora' },
				{ icon: 'Coffee', text: 'Nespresso y cafetera italiana' },
			]}
		/>
		<Reviews heading="Qué dicen nuestros clientes" eyebrow="Testimonios" />
		<script id="shapo-embed-js" type="text/javascript" src="https://cdn.shapo.io/js/embed.js" defer></script>
	</main>
</Layout>
