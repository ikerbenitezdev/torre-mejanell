---
export const lang = 'ca';
export const slug = 'historia';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import BuildingAnimation from '../../src/components/home/BuildTower.astro';

import castellAntic from '../../src/assets/pages/historia/torre-mejanell-antiga.webp'; 
import historiaTorre from '../../src/assets/pages/historia/historia-torre.webp';
import antigaTorre from '../../src/assets/pages/historia/historica-torre.webp';
---


<Layout lang={lang} slug={slug} title="Els orígens | Torre de Mejanell">
  <main class="bg-[#fcfbf9] text-[#1f1a17] overflow-x-hidden">
    
    <!-- Hero Section -->
    <section class="relative min-h-[90vh] flex flex-col lg:flex-row items-center justify-center bg-[#1a1715] px-10 py-20 md:py-0 md:px-20 gap-12 overflow-hidden border-b border-[#2d2a28]">
        <div class="absolute inset-0 bg-gradient-to-br from-[#26211e] via-[#1a1715] to-[#12100f] pointer-events-none"></div>
        <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('https://www.transparenttextures.com/patterns/carbon-fibre.png');"></div>

        <div class="w-full lg:w-1/2 max-w-xl relative z-10 space-y-8 text-left lg:pr-12">
            <span class="inline-block text-[10px] font-bold tracking-[0.3em] uppercase text-[#c5a073]">Llegat, pedra i transformació</span>
            <h1 id="hero-title" class="text-4xl md:text-6xl font-serif text-[#f4efe9] tracking-tight leading-[0.95]">
                Els orígens de la Torre de Mejanell
            </h1>
            <p id="hero-desc" class="text-base text-[#d1ccc6] font-light leading-relaxed max-w-md border-l border-[#c5a073]/30 pl-6">
                Des de la torre de guaita medieval fins a la casa rural que avui acull visitants amb calma, història i autenticitat.
            </p>
        </div>

        <div id="hero-animation" class="w-full lg:w-1/2 flex justify-center items-center relative z-10">
            <BuildingAnimation class="w-full h-auto max-w-[550px] lg:max-w-[650px] brightness-[1.1] contrast-[1.2]" />
        </div>
    </section>

    
    <section class="py-24 px-6 max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div class="space-y-6">
                <h2 class="text-4xl font-serif text-[#1f1a17]">El llegat medieval</h2>
                <div class="space-y-4 text-base text-[#6b5f56] leading-relaxed">
                    <p>La Torre de Mejanell és un antic castell del segle XI del qual s'ha conservat la Torre de Defensa circular amb una alçada actual de 13 metres.</p>
                    <p>La masia es va construir al segle XIV i es va integrar a la torre aprofitant la seva paret corbada com a pròpia de la casa.</p>
                    <p>Tot el conjunt medieval forma part dels béns comarcals d'interès nacional (BCIN) i de la ruta jacobea catalana, una mostra viva de la història del territori.</p>
                    <p>La casa ha estat restaurada respectant les característiques originals i convertida en un allotjament rural de qualitat, on encara es poden reconèixer les restes del castell, les arcades, l'estable i el celler.</p>
                </div>
            </div>
            <!-- Espacio para imagen histórica 1 -->
            <div class="aspect-[4/3] bg-[#e8e4de] rounded-2xl flex items-center justify-center text-[#7a5a3d]/50 italic">
               <Image src={castellAntic} alt="Castell de Mejanell" class="w-full h-full object-cover rounded-2xl" />
            </div>
        </div>
        
        <!-- Espacio para imagen de detalle (opcional) -->
        <div class="mt-6 grid grid-cols-1 lg:grid-cols-14 gap-6 items-center">
            <div class="lg:col-span-6 aspect-[4/3] bg-[#e8e4de] rounded-2xl overflow-hidden shadow-lg">
                <Image src={historiaTorre} alt="Historia de la Torre de Mejanell" class="w-full h-full object-cover rounded-2xl" />
            </div>
            <div class="lg:col-span-8 aspect-[16/9] bg-[#e8e4de] rounded-2xl overflow-hidden shadow-lg">
                <Image src={antigaTorre} alt="Antiga Torre de Mejanell" class="w-full h-full object-cover rounded-2xl" />
            </div>
        </div>
        <div class="py-12 flex justify-center items-center">
            <a href="/preus-i-ocupacio" class="inline-flex items-center justify-center relative z-30 rounded-full text-xs px-8 py-4 font-bold bg-[#1f1a17] hover:bg-[#7a5a3d] transition-all duration-300 shadow-md hover:-translate-y-0.5 uppercase tracking-wider" style="color: #f4efe9; isolation: isolate;">
                Reserva la teva estada
            </a>
        </div>
    </section>

    


        
  </main>
</Layout>

<script type="module">
    import { animate, inView, cubicBezier } from "motion";
    const premiumEase = cubicBezier(0.16, 1, 0.3, 1);

    if (typeof window !== "undefined") {
        animate("#hero-title, #hero-desc", { opacity: [0, 1], x: [-20, 0] }, { duration: 1.4, delay: 0.3, easing: premiumEase });
        animate("#hero-animation", { opacity: [0, 1], scale: [0.95, 1] }, { duration: 1.8, easing: premiumEase });
        inView(".wine-step", (info) => {
            animate(info.target, { opacity: [0, 1], y: [40, 0] }, { duration: 1, easing: premiumEase });
        }, { margin: "-20% 0px -20% 0px" });
    }
</script>