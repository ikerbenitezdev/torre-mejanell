---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import StaysSelector from '../components/home/StaysSelector.astro';
import { BedDouble, Trees, ChefHat, Citrus, Coffee } from 'lucide-astro';
import habitacionsHero from '../assets/pages/rooms/torre-mejanell-3-persones.webp'; 
import { Image } from 'astro:assets';
import roomTriple from '../assets/pages/rooms/torre-mejanell-3-persones.webp';
import roomDoubleGround from '../assets/pages/rooms/torre-mejanell-doble2.webp';
import roomTwoGroundA from '../assets/pages/rooms/torre-mejanell-2-persones3.webp';
import roomTwoFirst from '../assets/pages/rooms/torre-mejanell-2-persones.webp';
import roomTwoGroundB from '../assets/pages/rooms/torre-mejanell-2-persones4.webp';
import roomDoubleFirst from '../assets/pages/rooms/torre-mejanell-doble1.webp';
import roomIndividual from '../assets/pages/rooms/habitacio-individual1.webp';
import roomGroundFloor from '../assets/pages/rooms/habitació planta baixa.webp';

const rooms = [
  { title: 'Habitació triple + bressol (Primera Planta)', text: 'Habitació de tres llits individuals amb bressol i bany dins l’habitació.', image: roomTriple },
  { title: 'Habitació doble (Planta baixa)', text: 'Habitació a la planta baixa per a dues persones amb bany compartit. ', image: roomDoubleFirst },
  { title: 'Habitació doble (Planta baixa)', text: 'Habitació a la planta baixa amb dos llits amb bany compartit.', image: roomDoubleGround },
  { title: 'Habitació doble capicuada (Primera Planta)', text: 'Dos llits individuals amb bany compartit.', image: roomTwoFirst },
  { title: 'Habitació doble (Primera Planta)', text: 'Llit de matrimoni amb bany compartit.', image: roomTwoGroundA },
  { title: 'Habitació doble (Segona Planta)', text: 'Dos llits individuals amb bany dins l’habitació.', image: roomTwoGroundB },
  { title: 'Habitació individual (Segona planta)', text: 'Habitació amb 1 llit estàndar amb opció d’afegir un llit supletori.', image: roomIndividual },
];


export const lang = 'ca';
export const slug = 'habitacions';
---

<Layout lang={lang} slug={slug} title="Habitacions | Castell de Mejanell">
  <main class="text-[#1f1a17] overflow-x-hidden relative">
    
    <!-- <Hero 
        tag="La Casa"
        title="Habitacions"
        subtitle="Espais dissenyats per descansar i gaudir en família "
        image={habitacionsHero}
    /> -->
    <StaysSelector lang={lang}/>
    <section class="py-20 bg-[#fcfbf9]">
    <div class="max-w-6xl mx-auto px-6">
        <div class="mb-16 text-center">
            <h2 class="text-3xl font-serif text-[#1f1a17]">Més que una estada</h2>
            <div class="w-12 h-[1px] bg-[#7a5a3d]/40 mx-auto mt-6"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-12">
            <!-- Confort -->
            <div class="flex flex-col items-center text-center group">
                <div class="p-4 rounded-full bg-[#f6efe4] text-[#7a5a3d] mb-6 group-hover:scale-110 transition-transform">
                    <BedDouble size={32} />
                </div>
                <h3 class="font-serif text-xl mb-3">Confort de somni</h3>
                <p class="text-sm text-[#6b5f56] leading-relaxed">Gaudeix d'un descans reparador en els nostres llits ben equipats, enmig de la pau total de la Segarra.</p>
            </div>

            <!-- Entorno -->
            <div class="flex flex-col items-center text-center group">
                <div class="p-4 rounded-full bg-[#f6efe4] text-[#7a5a3d] mb-6 group-hover:scale-110 transition-transform">
                    <Trees size={32} />
                </div>
                <h3 class="font-serif text-xl mb-3">Entorn privilegiat</h3>
                <p class="text-sm text-[#6b5f56] leading-relaxed">Desperta envoltat de natura, vinyes i camps amb vistes úniques, ideal per desconnectar del ritme de la ciutat.</p>
            </div>

            <!-- Experiencia Gastronómica -->
            <div class="flex flex-col items-center text-center group">
                <div class="p-4 rounded-full bg-[#f6efe4] text-[#7a5a3d] mb-6 group-hover:scale-110 transition-transform">
                    <ChefHat size={32} />
                </div>
                <h3 class="font-serif text-xl mb-3">Gastronomia local</h3>
                <p class="text-sm text-[#6b5f56] leading-relaxed">Tasta els productes de la finca i els esmorzars artesans amb sabors autèntics de proximitat.</p>
            </div>
            </div>
        </div>
    </section>
    <section class="py-20 bg-[#f4efe9]">
        <div class="max-w-6xl mx-auto px-6">
            <div class="mb-14 rounded-[2rem] border border-[#e5dcd0] bg-white p-6 shadow-sm lg:p-8">
                <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
                    <div class="space-y-4">
                        <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-[#7a5a3d]">Mapa de l’allotjament</p>
                        <h3 class="text-2xl font-serif text-[#1f1a17]">Distribució de les habitacions</h3>
                        <p class="text-base text-[#6b5f56] leading-relaxed">Les estades de Torre de Mejanell s’organitzen entre planta baixa, primera i segona planta, amb espais pensats per a parelles, famílies i grups.</p>
                        <ul class="space-y-2 text-sm text-[#6b5f56]">
                            <li>• Planta baixa: habitacions més accessibles i de fàcil accés.</li>
                            <li>• Primera planta: habitacions dobles i familiars amb bany compartit.</li>
                            <li>• Segona planta: estades més tranquil·les amb bany interior en algunes unitats.</li>
                        </ul>
                    </div>
                    <div class="overflow-hidden rounded-[1.5rem] bg-[#e8e4de] shadow-sm aspect-[4/3]">
                        <Image src={roomGroundFloor} alt="Mapa de les habitacions de Torre de Mejanell" class="h-full w-full object-cover" loading="eager" />
                    </div>
                </div>
            </div>
        {rooms.map((room, index) => (
        <div class="room-card mb-12 grid md:grid-cols-[0.95fr_1.05fr] gap-8 items-center" style={`transition-delay: ${index * 140}ms`}>
          <div class="overflow-hidden rounded-2xl shadow-lg bg-[#e8e4de] aspect-[16/9]">
            <Image src={room.image} alt={room.title} class="w-full h-full object-cover object-bottom transition duration-700 ease-out hover:scale-105" />
                </div>
          <div class="space-y-4">
                    <h3 class="text-2xl font-serif text-[#1f1a17]">{room.title}</h3>
            <p class="text-base text-[#6b5f56]">{room.text}</p>
                </div>
            </div>
          ))}
          <!-- <Image src={habitacionsHero} alt="Habitacions de la Torre de Mejanell" class="w-full h-auto rounded-2xl shadow-lg" />
          <div class="mt-6 text-center">
            <h3 class="text-3xl font-serif text-[#1f1a17]">{room.title}</h3>
            <p class="text-lg text-[#6b5f56] mt-4">{room.text}</p>
            <div class="w-12 h-[1px] bg-[#7a5a3d]/40 mx-auto mt-6"></div>
          </div> -->
          </div>
        </section>
        
        
        <div class="my-12 max-w-3xl mx-auto px-5">
            <p class="text-base text-[#6b5f56] flex items-start text-left gap-2">
                <span class="h-1 w-1 rotate-45 transform shrink-0 bg-[#7a5a3d] mt-2.5"></span>
                <span>Per a grups més nombrosos, oferim la possibilitat d'allotjar fins a 18 persones gràcies als sofàs llit disponibles en habitacions seleccionades.</span>
            </p>
        </div>
    </div>

    <!-- MODAL DE GALERÍA -->
    <div id="gallery-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-[#1f1a17]/95 opacity-0 pointer-events-none transition-opacity duration-300 backdrop-blur-sm hidden">
      <button id="close-modal" class="absolute top-6 right-6 text-white/70 hover:text-white text-4xl font-sans transition-colors z-50 p-2 cursor-pointer">&times;</button>
      
      <div class="relative max-w-4xl w-full h-full max-h-[80vh] flex flex-col items-center justify-center px-4">
        <button id="prev-photo" class="absolute left-4 md:-left-16 text-white/60 hover:text-white text-5xl p-4 transition-colors z-50 cursor-pointer select-none">‹</button>
        
        <div class="w-full h-full flex items-center justify-center overflow-hidden rounded-2xl bg-[#2a2420]/30">
          <img id="modal-img" src="" alt="Galeria de l'habitació" class="max-w-full max-h-full object-contain select-none transition-all duration-200" />
        </div>
        
        <button id="next-photo" class="absolute right-4 md:-right-16 text-white/60 hover:text-white text-5xl p-4 transition-colors z-50 cursor-pointer select-none">›</button>
        <div id="modal-counter" class="text-[#b5a99e] text-xs font-sans tracking-widest mt-4 uppercase font-semibold">0 / 0</div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const modal = document.getElementById('gallery-modal');
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const closeModalBtn = document.getElementById('close-modal');
  const prevBtn = document.getElementById('prev-photo');
  const nextBtn = document.getElementById('next-photo');
  const counter = document.getElementById('modal-counter');
  const roomCards = document.querySelectorAll<HTMLElement>('.room-card');

  let currentGallery: string[] = [];
  let currentIndex = 0;

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    roomCards.forEach((card) => observer.observe(card));
  } else {
    roomCards.forEach((card) => card.classList.add('is-visible'));
  }

  function updateModalImage() {
    if (currentGallery.length === 0 || !modalImg || !counter) return;
    
    const resolvedSrc = currentGallery[currentIndex];

    modalImg.style.opacity = '0';
    setTimeout(() => {
      modalImg.src = resolvedSrc;
      counter.innerText = `${currentIndex + 1} / ${currentGallery.length}`;
      modalImg.style.opacity = '1';
    }, 150);
  }

  function openModal(galleryArray: string[]) {
    if (!galleryArray || !modal) return;
    currentGallery = galleryArray;
    currentIndex = 0;

    if (currentGallery.length > 0) {
      modal.classList.remove('hidden');
      void modal.offsetWidth; 
      modal.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden'; 
      updateModalImage();
    }
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = ''; 
    setTimeout(() => { modal.classList.add('hidden'); }, 300);
  }

  // Captura el JSON de URLs ya procesadas directamente
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const galleryBtn = target.closest('.open-gallery-btn');
    
    if (galleryBtn) {
      try {
        const rawData = galleryBtn.getAttribute('data-gallery');
        if (rawData) {
          const parsedGallery = JSON.parse(rawData);
          if (Array.isArray(parsedGallery)) openModal(parsedGallery);
        }
      } catch (err) {
        console.error("Error al abrir la galería:", err);
      }
    }
  });

  closeModalBtn?.addEventListener('click', closeModal);
  
  prevBtn?.addEventListener('click', () => {
    currentIndex = (currentIndex === 0) ? currentGallery.length - 1 : currentIndex - 1;
    updateModalImage();
  });

  nextBtn?.addEventListener('click', () => {
    currentIndex = (currentIndex === currentGallery.length - 1) ? 0 : currentIndex + 1;
    updateModalImage();
  });

  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  document.addEventListener('keydown', (e) => {
    if (!modal || modal.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft') prevBtn?.click();
    if (e.key === 'ArrowRight') nextBtn?.click();
  });
</script>